#!/usr/bin/env python3

"""
Create a Sublime Text project for a git worktree, cloned from the main repo's project.

Assumes we're using https://github.com/randy3k/ProjectManager (which we always are).

Finds the .sublime-project in the Projects dir whose folder points at the worktree's
main checkout, copies it (comments and all), and rewrites every path string under the
main checkout to the same path under the worktree. Output goes to Projects/worktrees/.

ln -s ~/repos/sublime_text_config/bin/sublime-worktree-project ~/.local/bin/sublime-worktree-project

Usage:
  sublime-worktree-project [WORKTREE] [--no-open] [--force] [--dry-run]
  sublime-worktree-project --prune [--dry-run]

WORKTREE defaults to the current directory. Override the Projects dir with SUBLIME_PROJECTS_DIR.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

PROJECTS_DIR = Path(
    os.environ.get(
        "SUBLIME_PROJECTS_DIR",
        "~/Library/Application Support/Sublime Text/Packages/User/Projects",
    )
).expanduser()
OUT_DIR = PROJECTS_DIR / "worktrees"
MARKER = "// generated by sublime-worktree-project"
HOME = str(Path.home())

STRING_RE = re.compile(r'"((?:[^"\\\n]|\\.)*)"')


def git(cwd: Path, *args: str) -> str:
    return subprocess.run(["git", "-C", str(cwd), *args], check=True, capture_output=True, text=True).stdout.strip()


def resolve(p: str, base: Path) -> Path:
    path = Path(p).expanduser()
    if not path.is_absolute():
        path = base / path
    return Path(os.path.realpath(path))


def tilde(p: Path) -> str:
    s = str(p)
    return "~" + s[len(HOME) :] if s == HOME or s.startswith(HOME + "/") else s


def strip_jsonc(text: str) -> str:
    """Drop // and /* */ comments (outside strings) and trailing commas."""
    out, i, n = [], 0, len(text)
    while i < n:
        c = text[i]
        if c == '"':
            m = STRING_RE.match(text, i)
            end = m.end() if m else n
            out.append(text[i:end])
            i = end
        elif text.startswith("//", i):
            i = text.find("\n", i)
            i = n if i == -1 else i
        elif text.startswith("/*", i):
            i = text.find("*/", i)
            i = n if i == -1 else i + 2
        else:
            out.append(c)
            i += 1
    return re.sub(r",(\s*[}\]])", r"\1", "".join(out))


def load_project(path: Path) -> dict:
    return json.loads(strip_jsonc(path.read_text()))


def folder_paths(project: dict, project_file: Path) -> list[Path]:
    return [resolve(f["path"], project_file.parent) for f in project.get("folders", []) if "path" in f]


def find_template(main_repo: Path) -> Path | None:
    for f in sorted(PROJECTS_DIR.glob("*.sublime-project")):
        try:
            if main_repo in folder_paths(load_project(f), f):
                return f
        except (json.JSONDecodeError, OSError) as e:
            print(f"warning: skipping {f.name}: {e}", file=sys.stderr)
    return None


def rewrite(text: str, template: Path, main_repo: Path, worktree: Path) -> str:
    """Repoint path strings under main_repo at worktree. Relative paths become absolute,
    since the generated project lives in a different directory than the template."""

    def sub(m: re.Match) -> str:
        raw = m.group(1)
        try:
            value = json.loads(f'"{raw}"')
        except json.JSONDecodeError:
            return m.group(0)
        if not value.startswith(("~", "/", ".")):
            return m.group(0)
        p = resolve(value, template.parent)
        if p == main_repo or main_repo in p.parents:
            new = worktree / p.relative_to(main_repo)
        elif not value.startswith(("~", "/")) and p.exists():
            new = p
        else:
            return m.group(0)
        return json.dumps(tilde(new) + ("/" if value.endswith("/") and value != "/" else ""))

    return STRING_RE.sub(sub, text)


def refresh_project_manager() -> None:
    """Project Manager caches its project list; ask it to rescan if Sublime is running."""
    if subprocess.run(["pgrep", "-x", "sublime_text"], check=False, capture_output=True).returncode == 0:
        cmd = 'project_manager {"action": "refresh_projects"}'
        subprocess.run(["subl", "--background", "--command", cmd], check=False)


def create(args: argparse.Namespace) -> int:
    start = Path(args.worktree).expanduser().resolve()
    try:
        worktree = Path(os.path.realpath(git(start, "rev-parse", "--show-toplevel")))
        common = git(start, "rev-parse", "--path-format=absolute", "--git-common-dir")
    except subprocess.CalledProcessError:
        print(f"error: {start} is not inside a git repo", file=sys.stderr)
        return 1
    main_repo = Path(os.path.realpath(common)).parent
    if worktree == main_repo:
        print(f"error: {worktree} is the main checkout, not a worktree", file=sys.stderr)
        return 1

    out = OUT_DIR / f"{main_repo.name}--{worktree.name}.sublime-project"
    template = find_template(main_repo)
    if template:
        body = rewrite(template.read_text(), template, main_repo, worktree)
        header = f"{MARKER} from {template.name}\n"
    else:
        print(f"warning: no project in {PROJECTS_DIR} points at {tilde(main_repo)}; using a bare project")
        body = json.dumps({"folders": [{"path": tilde(worktree)}]}, indent="\t") + "\n"
        header = f"{MARKER}\n"
    content = header + body

    if args.dry_run:
        print(f"would write {out}\n")
        print(content)
        return 0
    if out.exists() and not args.force:
        print(f"exists, leaving as is (use --force to regenerate): {out}")
    else:
        OUT_DIR.mkdir(parents=True, exist_ok=True)
        out.write_text(content)
        print(f"wrote {out}" + (f" (from {template.name})" if template else ""))
        refresh_project_manager()
    if not args.no_open:
        subprocess.run(["subl", "--project", str(out)], check=False)
    return 0


def prune(args: argparse.Namespace) -> int:
    """Delete generated projects (and their workspaces) whose worktree is gone."""
    removed = 0
    for f in sorted(OUT_DIR.glob("*.sublime-project")):
        text = f.read_text()
        if not text.startswith(MARKER):
            continue
        try:
            paths = folder_paths(json.loads(strip_jsonc(text)), f)
        except json.JSONDecodeError:
            continue
        if paths and not any(p.exists() for p in paths):
            for victim in (f, f.with_suffix(".sublime-workspace")):
                if victim.exists():
                    print(("would remove " if args.dry_run else "removed ") + str(victim))
                    if not args.dry_run:
                        victim.unlink()
            removed += 1
    if not removed:
        print("nothing to prune")
    elif not args.dry_run:
        refresh_project_manager()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("worktree", nargs="?", default=".", help="path inside the worktree (default: cwd)")
    ap.add_argument("--no-open", action="store_true", help="don't open the project in Sublime")
    ap.add_argument("--force", action="store_true", help="overwrite an existing generated project")
    ap.add_argument("--dry-run", action="store_true", help="print what would happen, change nothing")
    ap.add_argument("--prune", action="store_true", help="remove projects for deleted worktrees")
    args = ap.parse_args()
    return prune(args) if args.prune else create(args)


if __name__ == "__main__":
    sys.exit(main())
